# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (any Postgres works; Vercel Postgres / Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@localhost:5432/philosophiebook

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign user and admin JWTs. REQUIRED — the app refuses to start
# without it. Generate a strong random value, e.g.: openssl rand -base64 32
JWT_SECRET=

# Bearer token that protects the /api/cron/* endpoints.
# On Vercel, set CRON_SECRET in project env vars and Vercel Cron sends it automatically.
CRON_SECRET=

# ── LLM providers ───────────────────────────────────────────────────────────
# Providers can also be configured at runtime in the admin dashboard
# (System → Providers, stored in the database). The env vars below are the
# fallback chain used when no providers are configured in the DB.

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-pro
GEMINI_MODEL=

# Optional: force a specific provider ("claude" or "gemini").
# Default: first provider with a configured key.
AI_PROVIDER=

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of your deployment. Used for canonical URLs, OG images, robots.txt,
# llms.txt, and the agent API docs. Safe to expose to the browser (no secrets).
# Example (production instance): https://book.philosophie.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: Vercel Blob ───────────────────────────────────────────────────
# Only needed for persona avatar uploads in the admin dashboard.
# Read implicitly by the @vercel/blob SDK; auto-provisioned on Vercel.
# BLOB_READ_WRITE_TOKEN=
